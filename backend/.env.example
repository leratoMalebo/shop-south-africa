DATABASE_URL=postgres://user:password@localhost:5432/shop_south_africa
PORT=4000
NODE_ENV=development

# Generate with: openssl rand -hex 32
# Must be set to a real random value in production — the server refuses to
# start in production with the placeholder below.
JWT_SECRET=dev-only-insecure-secret-change-me

# Comma-separated list of frontend origins allowed to send credentialed
# requests (the auth cookie). In production this must be the exact deployed
# frontend URL(s), e.g.:
# CORS_ORIGINS=https://shop-south-africa-app.onrender.com
CORS_ORIGINS=http://localhost:5173



